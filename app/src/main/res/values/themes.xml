<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Aether" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">@android:color/black</item>
        <!-- Required for MainActivity to sit on top of the live system wallpaper like a real launcher -->
        <item name="android:windowShowWallpaper">true</item>
    </style>

    <!-- Used on MainActivity so returning Home never shows a launch flash/animation -->
    <style name="Theme.Aether.NoAnim" parent="Theme.Aether">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>
